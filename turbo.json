{
  "$schema": "https://turborepo.dev/schema.json",
  "ui": "tui",
  "globalDependencies": [".env"],
  "globalEnv": ["NODE_ENV"],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "inputs": ["$TURBO_DEFAULT$", ".env*"],
      "outputs": [".next/**", "!.next/cache/**", "!.next/dev/**", "dist/**"],
      "env": [
        "DATABASE_URL",
        "BETTER_AUTH_SECRET",
        "BETTER_AUTH_URL",
        "ANTHROPIC_API_KEY",
        "FIRECRAWL_API_KEY",
        "VOYAGE_API_KEY",
        "TRIGGER_PROJECT_REF",
        "TRIGGER_SECRET_KEY",
        "UPSTASH_REDIS_REST_URL",
        "UPSTASH_REDIS_REST_TOKEN",
        "R2_ACCOUNT_ID",
        "R2_ACCESS_KEY_ID",
        "R2_SECRET_ACCESS_KEY",
        "R2_BUCKET",
        "REVALIDATE_SECRET",
        "SENTRY_*",
        "SKIP_ENV_VALIDATION",
        "NEXT_PUBLIC_SITE_URL",
        "NEXT_PUBLIC_CMS_URL",
        "NEXT_PUBLIC_API_URL",
        "NEXT_PUBLIC_MEDIA_URL",
        "VERCEL",
        "NEXT_PUBLIC_PLAUSIBLE_DOMAIN",
        "INDEXNOW_KEY",
        "FIRECRAWL_RPM",
        "RESEND_API_KEY",
        "NOTIFY_EMAIL_FROM",
        "NOTIFY_WEBHOOK_URL",
        "TELEGRAM_BOT_TOKEN",
        "TELEGRAM_CHAT_ID",
        "TURNSTILE_SECRET_KEY",
        "NEXT_PUBLIC_TURNSTILE_SITE_KEY",
        "PLAUSIBLE_API_KEY",
        "IMPACT_ACCOUNT_SID",
        "IMPACT_AUTH_TOKEN",
        "PARTNERSTACK_API_KEY",
        "AWIN_API_TOKEN",
        "AWIN_PUBLISHER_ID",
        "ELEVENLABS_API_KEY",
        "YOUTUBE_CLIENT_ID",
        "YOUTUBE_CLIENT_SECRET",
        "YOUTUBE_REFRESH_TOKEN",
        "FAL_KEY",
        "PRODUCT_HUNT_TOKEN",
        "GSC_CLIENT_EMAIL",
        "GSC_PRIVATE_KEY",
        "GSC_SITE_URL",
        "VAULT_KEY",
        "HANDS_ON_INBOX_DOMAIN",
        "BROWSER_WS_ENDPOINT",
        "EXPO_ACCESS_TOKEN",
        "APPLE_TEAM_ID",
        "IOS_BUNDLE_ID",
        "ANDROID_PACKAGE",
        "ANDROID_CERT_SHA256"
      ]
    },
    "lint": {
      "dependsOn": ["^lint"]
    },
    "check-types": {
      "dependsOn": ["^check-types"]
    },
    "test": {
      "dependsOn": ["^build"],
      "inputs": ["$TURBO_DEFAULT$", ".env*"],
      "outputs": ["coverage/**"],
      "env": ["TEST_DATABASE_URL", "DATABASE_URL"]
    },
    "e2e": {
      "cache": false,
      "passThroughEnv": [
        "CI",
        "E2E_*",
        "PLAYWRIGHT_*",
        "DATABASE_URL",
        "BETTER_AUTH_SECRET",
        "BETTER_AUTH_URL",
        "NEXT_PUBLIC_*",
        "LH_*",
        "REVALIDATE_SECRET"
      ]
    },
    "dev": {
      "cache": false,
      "persistent": true,
      "passThroughEnv": ["PORT"]
    },
    "db:generate": {
      "cache": false
    },
    "db:migrate": {
      "cache": false,
      "env": ["DATABASE_URL"]
    },
    "db:seed": {
      "cache": false,
      "dependsOn": ["db:migrate"],
      "env": [
        "DATABASE_URL",
        "BETTER_AUTH_SECRET",
        "BETTER_AUTH_URL",
        "SEED_ADMIN_EMAIL",
        "SEED_ADMIN_PASSWORD",
        "NEXT_PUBLIC_CMS_URL"
      ]
    },
    "db:studio": {
      "cache": false,
      "persistent": true
    }
  },
  "globalPassThroughEnv": [
    "ENABLE_EXPERIMENTAL_COREPACK",
    "VERCEL_ENV",
    "VERCEL_GIT_COMMIT_REF",
    "TRIGGER_PREVIEW_BRANCH"
  ]
}
