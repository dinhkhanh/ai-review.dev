# Copy to .env at the repo root: `cp .env.example .env`. All apps and scripts load this file in development.
# On Vercel / Trigger.dev, set the same names in the platform's environment settings.

# --- Database (local docker: `pnpm db:up`) ---
DATABASE_URL=postgres://aireview:aireview@localhost:55432/aireview
TEST_DATABASE_URL=postgres://aireview:aireview@localhost:55432/aireview_test

# --- Public URLs ---
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_CMS_URL=http://localhost:3001
NEXT_PUBLIC_API_URL=http://localhost:3002

# --- CMS auth (Better Auth). Generate with: openssl rand -base64 32 ---
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3001
# First admin account, created by `pnpm db:seed`
SEED_ADMIN_EMAIL=admin@ai-review.dev
SEED_ADMIN_PASSWORD=

# --- AI providers ---
ANTHROPIC_API_KEY=
FIRECRAWL_API_KEY=
VOYAGE_API_KEY=

# --- Worker (Trigger.dev v4) ---
TRIGGER_PROJECT_REF=
TRIGGER_SECRET_KEY=

# --- Cache / rate limiting (Upstash) — needed from Phase 1 ---
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# --- Media storage (Cloudflare R2) — needed from Phase 1 ---
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
NEXT_PUBLIC_MEDIA_URL=

# --- Web revalidation (CMS -> web) ---
REVALIDATE_SECRET=

# --- Observability ---
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=

# --- Optional (Phase 1) ---
# Plausible site domain; cookieless, so no consent banner needed.
NEXT_PUBLIC_PLAUSIBLE_DOMAIN=
# IndexNow key; defaults to a hash of REVALIDATE_SECRET.
INDEXNOW_KEY=
# Firecrawl requests per minute for your plan (entry plan ≈ 10). The adapter paces and retries.
FIRECRAWL_RPM=10

# --- Phase 2 (all optional; features degrade gracefully without them) ---
# Notifications (FR-CMS-8): email via Resend, Slack-compatible webhook, Telegram bot.
RESEND_API_KEY=
NOTIFY_EMAIL_FROM=
NOTIFY_WEBHOOK_URL=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Cloudflare Turnstile for public write endpoints (votes, reports, newsletter). Skipped when unset.
TURNSTILE_SECRET_KEY=
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
# Plausible Stats API key: daily page-view import for funnels and the refresh cadence.
PLAUSIBLE_API_KEY=
# Affiliate network reporting APIs (conversion import, FR-AFF-11).
IMPACT_ACCOUNT_SID=
IMPACT_AUTH_TOKEN=
PARTNERSTACK_API_KEY=
AWIN_API_TOKEN=
AWIN_PUBLISHER_ID=
# Video (FR-VID): ElevenLabs TTS and YouTube upload (OAuth refresh token for the channel).
ELEVENLABS_API_KEY=
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
YOUTUBE_REFRESH_TOKEN=
# Generative images (FR-MED-2) via fal.ai.
FAL_KEY=
# Product sourcing (FR-INT-7): Product Hunt API token (falls back to the public feed).
PRODUCT_HUNT_TOKEN=

# --- Phase 3 (all optional; features stay off without them) ---
# Search Console import (FR-MNT-3): service account with read access to the property.
# GSC_SITE_URL is the property id, e.g. sc-domain:ai-review.dev or https://ai-review.dev/.
GSC_CLIENT_EMAIL=
GSC_PRIVATE_KEY=
GSC_SITE_URL=
# Credential vault for hands-on trials (FR-RES-7): 32 random bytes, base64 (`openssl rand -base64 32`).
VAULT_KEY=
# Hands-on trials: domain whose mail Resend receives (test-identity sign-ups use addresses on it).
HANDS_ON_INBOX_DOMAIN=
# Optional remote browser (CDP websocket); the worker launches local Chromium when unset.
BROWSER_WS_ENDPOINT=
# Mobile push (FR-API-4): Expo access token when "enhanced push security" is on for the project.
EXPO_ACCESS_TOKEN=
# Universal/app links (apple-app-site-association, assetlinks.json) served by apps/web.
APPLE_TEAM_ID=
IOS_BUNDLE_ID=
ANDROID_PACKAGE=
ANDROID_CERT_SHA256=
