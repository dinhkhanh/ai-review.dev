# Copy to .env at the repo root: `cp .env.example .env`. All apps and scripts load this file in development.
# On Vercel / Trigger.dev, set the same names in the platform's environment settings.

# --- Database (local docker: `pnpm db:up`) ---
DATABASE_URL=postgres://aireview:aireview@localhost:55432/aireview
TEST_DATABASE_URL=postgres://aireview:aireview@localhost:55432/aireview_test

# --- Public URLs ---
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_CMS_URL=http://localhost:3001
NEXT_PUBLIC_API_URL=http://localhost:3002

# --- CMS auth (Better Auth). Generate with: openssl rand -base64 32 ---
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3001
# First admin account, created by `pnpm db:seed`
SEED_ADMIN_EMAIL=admin@ai-review.dev
SEED_ADMIN_PASSWORD=

# --- AI providers ---
ANTHROPIC_API_KEY=
FIRECRAWL_API_KEY=
VOYAGE_API_KEY=

# --- Worker (Trigger.dev v4) ---
TRIGGER_PROJECT_REF=
TRIGGER_SECRET_KEY=

# --- Cache / rate limiting (Upstash) — needed from Phase 1 ---
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# --- Media storage (Cloudflare R2) — needed from Phase 1 ---
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
NEXT_PUBLIC_MEDIA_URL=

# --- Web revalidation (CMS -> web) ---
REVALIDATE_SECRET=

# --- Observability ---
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=

# --- Optional (Phase 1) ---
# Plausible site domain; cookieless, so no consent banner needed.
NEXT_PUBLIC_PLAUSIBLE_DOMAIN=
# IndexNow key; defaults to a hash of REVALIDATE_SECRET.
INDEXNOW_KEY=
# Firecrawl requests per minute for your plan (entry plan ≈ 10). The adapter paces and retries.
FIRECRAWL_RPM=10
