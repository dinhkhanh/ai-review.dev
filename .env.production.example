# Production values. Copy to .env.production.local (gitignored), fill the blanks, then:
#   node scripts/prod.mjs env:push     # pushes to the Vercel projects (values never printed)
#   node scripts/prod.mjs db:migrate   # applies migrations to Supabase
#   node scripts/prod.mjs db:seed      # categories, settings, first admin
# Resource inventory: docs/deploy.md

# Supabase project "ai-review" (ref ludkxxthvuhjxurticyk, us-east-1).
# Dashboard -> Connect -> Shared Pooler, Transaction mode (host aws-0-us-east-1.pooler.supabase.com,
# port 6543, user postgres.<ref>) for the apps. Not the db.<ref>.supabase.co host: it is IPv6-only
# and unreachable from Vercel.
DATABASE_URL=
# Same Shared Pooler in Session mode (port 5432) for migrations:
DATABASE_URL_MIGRATIONS=

# CMS auth. Generated fresh for production; never reuse the dev secret.
BETTER_AUTH_SECRET=
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=

# Upstash Redis "ai-review" (us-east-1). Console -> database -> REST API.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Web revalidation shared secret (CMS -> web).
REVALIDATE_SECRET=

# Trigger.dev project -> API keys -> Production secret key (tr_prod_…, not tr_dev_…). The CMS triggers pipeline runs with it.
TRIGGER_SECRET_KEY=

# --- Phase 1: AI pipeline and media ---
# Used by the Trigger.dev worker (synced on `pnpm --filter worker run deploy`) and by the CMS.
ANTHROPIC_API_KEY=
FIRECRAWL_API_KEY=
# Optional: without it (or while the Voyage account is rate-limited) retrieval uses full-text search.
VOYAGE_API_KEY=
# Cloudflare R2 bucket ai-review-media: Object Read & Write token scoped to the bucket.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=ai-review-media
# Public base URL of the bucket (r2.dev URL or a custom domain such as https://media.ai-review.dev).
NEXT_PUBLIC_MEDIA_URL=
NEXT_PUBLIC_SITE_URL=https://ai-review.dev
# Worker DSN from Sentry (optional).
SENTRY_DSN=

# --- Phase 2 (optional; each feature is skipped while its keys are empty) ---
# Notifications: Resend API key + verified sender, e.g. "AI Review <alerts@ai-review.dev>";
# Slack incoming webhook and/or Telegram bot. Recipients are set in CMS Settings.
RESEND_API_KEY=
NOTIFY_EMAIL_FROM=
NOTIFY_WEBHOOK_URL=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
NEXT_PUBLIC_CMS_URL=https://admin.ai-review.dev
# Cloudflare Turnstile widget for votes, reports and newsletter sign-up.
TURNSTILE_SECRET_KEY=
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
# Plausible -> Settings -> API keys (Stats API).
PLAUSIBLE_API_KEY=
NEXT_PUBLIC_PLAUSIBLE_DOMAIN=ai-review.dev
# Network reporting APIs for conversion import.
IMPACT_ACCOUNT_SID=
IMPACT_AUTH_TOKEN=
PARTNERSTACK_API_KEY=
AWIN_API_TOKEN=
AWIN_PUBLISHER_ID=
# Video pipeline.
ELEVENLABS_API_KEY=
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
YOUTUBE_REFRESH_TOKEN=
# Generative images (fal.ai).
FAL_KEY=
# Product Hunt developer token (optional; the public feed is used without it).
PRODUCT_HUNT_TOKEN=

# --- Phase 3 (all optional; features stay off without them) ---
# Search Console import (FR-MNT-3): service account with read access to the property.
# GSC_SITE_URL is the property id, e.g. sc-domain:ai-review.dev or https://ai-review.dev/.
GSC_CLIENT_EMAIL=
GSC_PRIVATE_KEY=
GSC_SITE_URL=
# Credential vault for hands-on trials (FR-RES-7): 32 random bytes, base64 (`openssl rand -base64 32`).
VAULT_KEY=
# Hands-on trials: domain whose mail Resend receives (test-identity sign-ups use addresses on it).
HANDS_ON_INBOX_DOMAIN=
# Optional remote browser (CDP websocket); the worker launches local Chromium when unset.
BROWSER_WS_ENDPOINT=
# Mobile push (FR-API-4): Expo access token when "enhanced push security" is on for the project.
EXPO_ACCESS_TOKEN=
# Universal/app links (apple-app-site-association, assetlinks.json) served by apps/web.
APPLE_TEAM_ID=
IOS_BUNDLE_ID=
ANDROID_PACKAGE=
ANDROID_CERT_SHA256=
