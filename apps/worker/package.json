{
  "name": "worker",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "deploy": "pnpm --filter @repo/video bundle && trigger deploy",
    "lint": "eslint . --max-warnings 0",
    "check-types": "tsc --noEmit",
    "test": "vitest run",
    "run-job": "tsx --env-file-if-exists=../../.env scripts/run-job.ts",
    "runner": "tsx --env-file-if-exists=../../.env scripts/run-job.ts --poll",
    "video": "tsx --env-file-if-exists=../../.env scripts/run-video.ts",
    "youtube-auth": "tsx --env-file-if-exists=../../.env scripts/youtube-auth.ts"
  },
  "dependencies": {
    "@fontsource/inter": "5.3.0",
    "@repo/ai": "workspace:*",
    "@repo/core": "workspace:*",
    "@repo/db": "workspace:*",
    "@repo/media": "workspace:*",
    "@repo/observability": "workspace:*",
    "@repo/pipeline": "workspace:*",
    "@repo/video": "workspace:*",
    "@resvg/resvg-js": "2.6.2",
    "@sentry/node": "10.75.3",
    "@trigger.dev/sdk": "4.7.3",
    "playwright-core": "1.64.0",
    "sharp": "0.35.5",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@repo/eslint-config": "workspace:*",
    "@repo/typescript-config": "workspace:*",
    "@trigger.dev/build": "4.7.3",
    "@types/node": "26.6.4",
    "eslint": "10.9.1",
    "trigger.dev": "4.7.3",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "vitest": "5.0.3"
  }
}
