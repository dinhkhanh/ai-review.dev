{
  "$schema": "https://json.schemastore.org/tsconfig",
  // Vercel's Node builder compiles through a temporary tsconfig in the OS temp dir that extends
  // this file, so type roots must be pinned relative to this file or @types/node is not found.
  "compilerOptions": {
    "target": "ES2023",
    "lib": ["es2023"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "moduleDetection": "force",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noUnusedLocals": true,
    "noFallthroughCasesInSwitch": true,
    "esModuleInterop": true,
    "isolatedModules": true,
    "verbatimModuleSyntax": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "noEmit": true,
    "types": ["node"],
    "typeRoots": ["./node_modules/@types"]
  },
  "include": ["src", "*.ts"],
  "exclude": ["node_modules", "dist"]
}
