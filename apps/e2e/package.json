{
  "name": "e2e",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "lint": "eslint . --max-warnings 0",
    "check-types": "tsc --noEmit",
    "seed": "tsx --env-file-if-exists=../../.env src/seed.ts",
    "e2e": "playwright test",
    "lighthouse": "tsx src/lighthouse.ts"
  },
  "dependencies": {
    "@repo/auth": "workspace:*",
    "@repo/core": "workspace:*",
    "@repo/db": "workspace:*",
    "better-auth": "1.7.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@playwright/test": "1.64.0",
    "@repo/eslint-config": "workspace:*",
    "@repo/typescript-config": "workspace:*",
    "@types/node": "26.6.4",
    "eslint": "10.9.1",
    "lighthouse": "13.5.0",
    "tsx": "4.23.15",
    "typescript": "7.0.2"
  }
}
